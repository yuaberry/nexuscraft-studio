    "prebuild:ios": "expo prebuild -p ios --no-install"
  },
  "dependencies": {
    "@voxel/core": "workspace:*",
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "babel-preset-expo": "^11.0.6",
    "typescript": "^5.3.3"
  }
