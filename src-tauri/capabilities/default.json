{
  "identifier": "default",
  "description": "NexusCraft Studio default capabilities — least privilege set for Phase 0",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://openrouter.ai/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
