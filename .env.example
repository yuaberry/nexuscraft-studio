# ============================================================================
# NexusCraft Studio — Environment template
# ============================================================================
# Copy this file to `.env` and fill in the values locally.
# `.env` is GITIGNORED — secrets must never be committed.
#
# IMPORTANT (read before filling):
#   - The desktop app is LOCAL-FIRST. It runs 100% offline with none of this
#     filled in. AI provider keys belong in the app: Settings → AI
#     (stored in your OS credential manager, not here).
#   - The variables below serve two purposes:
#       1) Vite build-time frontend flags (VITE_* — embedded in the bundle,
#          so NEVER put secret/service keys there).
#       2) Local development/tooling variables (no prefix — dev machine only).
# ============================================================================

# ---------------------------------------------------------------------------
# Cloud backend (optional) — Supabase
# ---------------------------------------------------------------------------
# Used by the FUTURE cloud layer: project sync, marketplace, telemetry.
# Nothing in the current build phones home — the app remains local-first.
# Create a project at https://supabase.com, then paste the values here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key — server-side only. NEVER prefix it with VITE_.
# Used only by local admin scripts/tools (e.g. provisioning tables later).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# GitHub integration (optional — Phase 7)
# ---------------------------------------------------------------------------
# Personal access token used by CLI tools/scripts. The app's GitHub features
# use OAuth device flow through the UI instead — this is for automation only.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# AI provider keys — DEV FALLBACK ONLY
# ---------------------------------------------------------------------------
# The app reads keys from the OS keyring (Settings → AI). These variables are
# a convenience for local scripts/tests that talk to providers directly.
# Leave empty if you don't need them.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
